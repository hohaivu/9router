# 9Router Docker runtime configuration
# Copy to .env, replace every placeholder, then restrict it: chmod 600 .env
# This file is intentionally excluded from Git and Docker image builds.

# Required for a stable, secure deployment
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_PASSWORD=replace-with-a-strong-initial-password
API_KEY_SECRET=replace-with-a-long-random-secret
MACHINE_ID_SALT=replace-with-a-long-random-secret

# Container runtime; compose.yaml enforces DATA_DIR=/app/data.
PORT=20128
NODE_ENV=production

# Set these to the URL users actually use. For local-only Docker, keep localhost.
# Behind an HTTPS reverse proxy, use the public HTTPS URL and set AUTH_COOKIE_SECURE=true.
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Security and observability
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
# Set true for an internet-exposed instance, then configure clients with an API key.
REQUIRE_API_KEY=false

# Optional outbound proxy variables for upstream provider calls.
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Optional external Headroom service. Compose does not start Headroom automatically.
# HEADROOM_URL=http://host.docker.internal:8787
